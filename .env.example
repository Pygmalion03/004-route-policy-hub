# 管理功能需要独立长密码；真实 .env 不提交。
ADMIN_PASSWORD=replace-with-a-long-private-password
# 私有入口的 Host（包括端口），例如 nas.local:8787。
LAN_MANAGEMENT_HOST=
ZTE_ROUTER_URL=
ZTE_ROUTER_USERNAME=
ZTE_ROUTER_PASSWORD=
# 容器内可读的私人凭据文件路径，可替代上面的明文密码变量。
ZTE_ROUTER_CREDENTIALS_FILE=
# 仅在宿主控制器与 DATA_DIR 下的私有网络配置均已安装时开启。
RPH_ONECLICK_ENABLED=0
